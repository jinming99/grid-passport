{
  "name": "@grid-passport/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Agent Skills for Grid Passport — small, named, single-responsibility agents with explicit write-scope contracts. See docs/design/research-thesis.md.",
  "exports": {
    "./interviewer/validator": "./interviewer/src/validator.ts"
  },
  "scripts": {
    "validate:interviewer": "tsx interviewer/scripts/validate_caseinput.ts",
    "validate:cartographer": "tsx cartographer/scripts/validate_publicevidence.ts",
    "baseline": "tsx scripts/export_prompt_only.ts --all",
    "baseline:check": "tsx scripts/export_prompt_only.ts --all --check",
    "baseline:interviewer": "tsx scripts/export_prompt_only.ts interviewer",
    "baseline:cartographer": "tsx scripts/export_prompt_only.ts cartographer",
    "metrics": "tsx scripts/compute_metrics.ts",
    "metrics:check": "tsx scripts/compute_metrics.ts --check"
  },
  "dependencies": {
    "@grid-passport/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@types/node": "^20"
  }
}
